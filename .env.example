# ─────────────────────────────────────────
# MoneyPrinterTurbo
# ─────────────────────────────────────────
MPT_API_URL=http://localhost:8080
MPT_OUTPUT_DIR=./MoneyPrinterTurbo/storage/cache/videos

# ─────────────────────────────────────────
# YouTube Data API v3
# Gere em: console.cloud.google.com
# ─────────────────────────────────────────
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ─────────────────────────────────────────
# TikTok Content Posting API
# Gere em: developers.tiktok.com
# ─────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ─────────────────────────────────────────
# Canais (preencher após criar as contas)
# ─────────────────────────────────────────
YOUTUBE_CHANNEL_ID=
TIKTOK_OPEN_ID=

# ─────────────────────────────────────────
# Copa 2026 — animação de gols via IA
# Chave do fal.ai: fal.ai/dashboard/keys
# ─────────────────────────────────────────
FAL_KEY=
# Modelo de vídeo (padrão: Kling v2). Alternativas:
#   fal-ai/runway-gen3/turbo/image-to-video
#   fal-ai/luma-dream-machine
COPA_ANIM_MODEL=fal-ai/kling-video/v2/master/text-to-video
